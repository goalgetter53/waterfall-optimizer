# Copy to .env and fill in. Never commit real keys.

# simulated | live
WFO_MODE=simulated
WFO_DB_PATH=.wfo/wfo.db

# Economics
WFO_VALUE_PER_VERIFIED=0.50       # USD value you assign to one verified email
WFO_MAX_SPEND_PER_CONTACT=0.30    # hard per-contact cap
WFO_BUDGET_USD=                   # optional global budget (empty = unlimited)

# Runtime
WFO_CONCURRENCY=8
WFO_VISIBILITY_TIMEOUT_S=60
WFO_RATE_PER_S=10                 # per-provider token bucket
WFO_BURST=20
WFO_WEBHOOK_SECRET=               # HMAC-SHA256 secret for completion webhooks

# Simulation mode
WFO_SIM_SEED=7
WFO_SIM_LATENCY_SCALE=0.01        # 1.0 = realistic latency, 0 = instant

# Live mode: an adapter is enabled for every key that is set
HUNTER_API_KEY=
APOLLO_API_KEY=
PROSPEO_API_KEY=
DROPCONTACT_API_KEY=
# Optional per-call price overrides (USD)
WFO_HUNTER_COST=
WFO_APOLLO_COST=
WFO_PROSPEO_COST=
WFO_DROPCONTACT_COST=
